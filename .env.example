# Database Configuration
EVAL_DB_NAME=chess_evaluations
EVAL_DB_USER=chess_user
EVAL_DB_PASSWORD=chess_password
EVAL_DB_HOST=localhost
EVAL_DB_PORT=5432
EVAL_DB_SSLMODE=prefer

# DeepSeek API for LLM insights
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Stripe Configuration
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe Price IDs
# Create products in Stripe Dashboard and paste the price IDs here
STRIPE_STANDARD_PRICE_ID=price_standard_plan_id_here
STRIPE_MAX_PRICE_ID=price_max_plan_id_here

# Stripe Webhook Secret
# Get this from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
